# Use PostgreSQL in every real environment. Keep this server-only and URL-encode password characters.
DATABASE_URL=postgresql+psycopg://USER:URL_ENCODED_PASSWORD@HOST:5432/postgres?sslmode=require
# Keep the application below the database provider's session-pool limit.
DATABASE_POOL_SIZE=2
DATABASE_MAX_OVERFLOW=1
APP_ENV=development
DEMO_MODE=false
# Generate a secret with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
ALLOWED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
STORAGE_BACKEND=local
STORAGE_LOCAL_DIR=./uploads
STORAGE_BUCKET=venue-images
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Set these as environment variables in Render for Supabase S3 storage.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL_S3=
AWS_REGION=
# Local development also reads these from backend/.env.
# Never put these credentials in frontend environment variables.
# Production values and deployment order: ../docs/deployment.md
