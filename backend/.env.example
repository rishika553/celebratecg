# SQLite is for explicit local demo/development only. Use Supabase PostgreSQL in production.
DATABASE_URL=sqlite:///./celebratecg.db
APP_ENV=development
DEMO_MODE=true
# Generate a secret with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
ALLOWED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
STORAGE_BACKEND=local
STORAGE_LOCAL_DIR=./uploads
STORAGE_BUCKET=venue-images
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Set these as environment variables in Render for Supabase S3 storage.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL_S3=
AWS_REGION=
# boto3 reads AWS_* from the process environment, not this dotenv file.
# Local S3 testing: export them in your shell before starting the backend.
# Production values and deployment order: ../docs/deployment.md
